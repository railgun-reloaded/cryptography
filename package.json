{
  "name": "@railgun-reloaded/cryptography",
  "version": "0.0.1",
  "description": "Collection of cryptographic primitives used by RAILGUN",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "prepare": "tsc --build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "pretest": "npm run build",
    "test": "npm run build && node --test --enable-source-maps ./test/*.test.js",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://git@github.com/railgun-reloaded/cryptography.git"
  },
  "keywords": [
    "railgun",
    "cryptography",
    "poseidon",
    "eddsa",
    "babyjubjub",
    "aes",
    "keccak"
  ],
  "author": "RAILGUN Project Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/railgun-reloaded/cryptography/issues"
  },
  "homepage": "https://github.com/railgun-reloaded/cryptography#readme",
  "devDependencies": {
    "@railgun-reloaded/eslint-config": "^1.1.0",
    "@railgun-reloaded/tsconfig": "^1.2.0",
    "@types/node": "^24.0.10",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@iden3/js-crypto": "^1.3.3",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@railgun-reloaded/bytes": "git+https://github.com/railgun-reloaded/bytes.git#dev",
    "poseidon-lite": "^0.3.0"
  }
}
